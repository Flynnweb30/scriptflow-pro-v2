rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsResource() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /appointments/{id} {
      allow read: if ownsResource();
      allow create: if ownsIncoming();
      allow update: if ownsResource() && ownsIncoming();
      allow delete: if ownsResource();
    }

    match /scripts/{id} {
      allow read: if ownsResource();
      allow create: if ownsIncoming();
      allow update: if ownsResource() && ownsIncoming();
      allow delete: if ownsResource();
    }

    match /tasks/{id} {
      allow read: if ownsResource();
      allow create: if ownsIncoming();
      allow update: if ownsResource() && ownsIncoming();
      allow delete: if ownsResource();
    }

    match /closers/{id} {
      allow read: if ownsResource();
      allow create: if ownsIncoming();
      allow update: if ownsResource() && ownsIncoming();
      allow delete: if ownsResource();
    }
  }
}
